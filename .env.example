# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Load it with:  dbx-mcp --env-file .env   (or set these in your MCP client's "env" block)

# --- Databricks authentication (handled by the Databricks SDK; pick ONE method) ---------------
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# Personal access token:
DATABRICKS_TOKEN=
# ...or OAuth machine-to-machine (service principal):
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# ...or a profile from ~/.databrickscfg (e.g. created by `databricks auth login`):
# DATABRICKS_CONFIG_PROFILE=DEFAULT

# --- Multi-workspace hosting (optional) ------------------------------------------------------
# With `dbx-mcp --auth-mode request --transport streamable-http`, the server needs NO Databricks
# credentials at all: each client sends X-Databricks-Host + Authorization: Bearer <PAT> headers.
# DBX_MCP_AUTH_MODE=request
# DBX_MCP_ALLOWED_WORKSPACE_HOSTS=.azuredatabricks.net,.cloud.databricks.com

# --- Server behaviour (all optional) --------------------------------------------------------
# DBX_MCP_TOOLSETS=all                       # or e.g. identity,sql,compute,unity_catalog
# DBX_MCP_DISABLED_TOOLS=execute_code
# DBX_MCP_READ_ONLY=false                    # true = only read actions are allowed
# DBX_MCP_BLOCKED_SAFETY_LEVELS=             # e.g. DESTRUCTIVE,SECURITY_SENSITIVE,EXECUTION
# DBX_MCP_REQUIRE_CONFIRMATION=true          # two-step confirm for destructive/security changes
# DBX_MCP_CONFIRM_EXECUTION=false            # also require confirm for code execution
# DBX_MCP_PROTECTED_NAME_PATTERNS=(?i)(^|[-_ .])prod(uction)?($|[-_ .])
# DBX_MCP_ALLOW_PROTECTED_CHANGES=false
# DBX_MCP_ALLOWED_VOLUME_PREFIXES=/Volumes/main/sandbox
# DBX_MCP_ALLOWED_WORKSPACE_PREFIXES=/Users/me@example.com
# DBX_MCP_LOCAL_FILE_ROOT=                   # enables local-file upload/download inside this dir
# DBX_MCP_DEFAULT_WAREHOUSE_ID=
# DBX_MCP_WAREHOUSE_SELECTION=prefer_running # or configured_only
# DBX_MCP_DEFAULT_CLUSTER_ID=
# DBX_MCP_SQL_MAX_ROWS=1000
# DBX_MCP_LOG_LEVEL=INFO
# DBX_MCP_DEBUG=false
